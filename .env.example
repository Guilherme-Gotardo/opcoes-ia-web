# API local. O build de producao recebe a origem regional abaixo por
# `.env.production`; nenhum destes valores e segredo.
VITE_API_URL=http://127.0.0.1:8000

# Para exercitar Cognito no Vite local, habilite e registre a callback local no
# app client antes de usar. O desenvolvimento normal continua sem auth.
# VITE_AUTH_ENABLED=true
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
